# PerpLog web app. It never signs and never sees KEY_ENCRYPTION_KEY or TREASURY_PRIVATE_KEY.

# Postgres (Neon pooled URL in production). Leave empty for the read-only product:
# protection routes then answer 503 db_unavailable and the UI hides Protect and Watch.
DATABASE_URL=

# Fixture mode for demos and e2e: serve captured accounts with no network access.
# PERPLOG_FIXTURE_DIR=../../packages/core/test/fixtures
