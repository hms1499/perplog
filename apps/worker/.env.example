# PerpLog worker: the only process that signs.
# `cp apps/worker/.env.example apps/worker/.env && chmod 600 apps/worker/.env`, then fill it in.
# `pnpm --filter @perplog/worker start` loads apps/worker/.env when it exists; variables already set in the
# environment (e.g. on Railway) win over the file. .env is gitignored and kept out of the Docker image.

# Postgres. Local Docker: postgres://postgres:pg@localhost:5433/postgres
# Neon: the DIRECT connection string (host without "-pooler", ?sslmode=require). The pooled one goes through
# PgBouncer in transaction mode, which breaks the session-level advisory lock that keeps a single signer.
# The worker refuses to start with a '-pooler' host.
DATABASE_URL=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts every bot key; losing it orphans them.
KEY_ENCRYPTION_KEY=
# 0x-prefixed private key of the STT treasury that tops up bot keys. Empty disables top-ups (with a warning).
TREASURY_PRIVATE_KEY=
NETWORK=hideki

# Optional endpoint overrides (defaults come from packages/chain/src/networks.ts).
RPC_HTTP_URL=
RPC_WS_URL=
INDEXER_URL=

# Gas top-ups, in STT (defaults 0.2 / 0.5 / 2).
GAS_TOPUP_THRESHOLD_STT=
GAS_TOPUP_AMOUNT_STT=
GAS_TOPUP_DAILY_CAP_STT=

LOG_LEVEL=info
